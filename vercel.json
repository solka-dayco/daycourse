{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    { 
      "source": "/course",
      "destination": "/api/og"
    },
    {
      "source": "/create",
      "destination": "/create.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/nickname",
      "destination": "/nickname.html"
    },
    {
      "source": "/find",
      "destination": "/find.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/user",
      "destination": "/user.html"
    },
    {
      "source": "/bookmarks",
      "destination": "/bookmarks.html"
    },
    {
      "source": "/notifications",
      "destination": "/notifications.html"
    },
    {
      "source": "/plan",
      "destination": "/plan.html"
    },
    {
      "source": "/plan-detail",
      "destination": "/plan-detail.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/admin.html"
    }
  ],
  "redirects": [
    {
      "source": "/main.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/course.html",
      "destination": "/course",
      "permanent": true
    },
    {
      "source": "/create.html",
      "destination": "/create",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/signup.html",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/nickname.html",
      "destination": "/nickname",
      "permanent": true
    },
    {
      "source": "/find.html",
      "destination": "/find",
      "permanent": true
    },
    {
      "source": "/profile.html",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/user.html",
      "destination": "/user",
      "permanent": true
    },
    {
      "source": "/bookmarks.html",
      "destination": "/bookmarks",
      "permanent": true
    },
    {
      "source": "/notifications.html",
      "destination": "/notifications",
      "permanent": true
    },
    {
      "source": "/plan.html",
      "destination": "/plan",
      "permanent": true
    },
    {
      "source": "/plan-detail.html",
      "destination": "/plan-detail",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}